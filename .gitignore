# Rust
/target
**/*.rs.bk

# Cargo
# Keep Cargo.lock for binaries for reproducible builds (uncomment to ignore for libs)
# Cargo.lock

# Python bytecode from the tools/ checkers
__pycache__/
*.py[cod]

# Editors/OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Local agent instructions
AGENTS.local.md
CLAUDE.md



# Test scripts
test_run.sh
run.sh

# Local release helper
tools/release.sh

# Packaging (but keep the service file)
packaging/**
!packaging/wayscriber.service
!packaging/AGENTS.md
!packaging/.SRCINFO
!packaging/PKGBUILD
!packaging/package.wayscriber.yaml
!packaging/package.configurator.yaml
!packaging/licenses/
!packaging/licenses/*.LICENSE
!packaging/icons/
!packaging/icons/*.png
!packaging/icons/*.svg
!packaging/nixpkgs/
!packaging/nixpkgs/package.nix
!packaging/nixpkgs/README.md
# The external wayscriber-configurator AUR recipe is owned here as a template
# pair. `packaging/**` ignores directories too, so the whole parent chain has to
# be re-included or git never descends far enough to see the templates.
!packaging/aur/
!packaging/aur/wayscriber-configurator/
!packaging/aur/wayscriber-configurator/PKGBUILD.tmpl
!packaging/aur/wayscriber-configurator/.SRCINFO.tmpl
!packaging/wayscriber.desktop
!packaging/wayscriber-configurator.desktop

.venv/

docs/board
docs/temp

dist/

# Performance testing scripts and results
perf/

scripts/
